<?xml version="1.0" encoding="utf-8"?>
<!-- ECHO Pulse widget: quiet lime rings behind the mascot, the still version of the ripple field in the app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center" android:width="150dp" android:height="150dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#22E8FF47"/></shape>
    </item>
    <item android:gravity="center" android:width="112dp" android:height="112dp">
        <shape android:shape="oval"><stroke android:width="1.5dp" android:color="#38E8FF47"/></shape>
    </item>
    <item android:gravity="center" android:width="78dp" android:height="78dp">
        <shape android:shape="oval"><solid android:color="#12E8FF47"/></shape>
    </item>
</layer-list>
