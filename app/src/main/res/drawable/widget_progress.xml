<?xml version="1.0" encoding="utf-8"?>
<!-- Widget progress bar: a thin graphite track with a lime fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><solid android:color="#2A2A2A"/><corners android:radius="2dp"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><solid android:color="#E8FF47"/><corners android:radius="2dp"/></shape></clip>
    </item>
</layer-list>
